# snippets
snippet library import "$DIR/libs.json"
snippet import "$DIR/snippets.json"
snippet list
snippet library list
snippet export "$DIR/snippets-out.json"
snippet library export "$DIR/libs-out.json"
snippet library remove hl7
snippet remove pid
snippet library remove hl7
snippet remove pid
snippet list extra
