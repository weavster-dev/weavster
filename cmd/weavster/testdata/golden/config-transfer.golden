# config-transfer
exportcfg "$DIR/cfg.json"
exportcfg "$DIR/cfg-map.json" overwriteconfigmap
importcfg "$DIR/cfg.json"
importcfg "$DIR/cfg.json" force nodeploy
importcfg "$DIR/cfg-map.json" overwriteconfigmap force
importcfg "$DIR/none.json"
exportcfg
