# alerts
importalert "$DIR/alerts.json"
importalert "$DIR/alerts.json"
importalert "$DIR/alerts.json" force
exportalert errors "$DIR/alert.json"
exportalert * "$DIR/alerts-out.json"
exportalert nope "$DIR/x.json"
importalert
