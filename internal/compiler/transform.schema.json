{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/weavster-dev/weavster/main/agent-docs/schemas/transform.schema.json",
  "title": "Weavster transform",
  "description": "A YAML DSL transform: steps run in order on the message as a JSON object (or the JSON view of an HL7 v2, XML, or delimited message). Used by a flow's transform, a destination's transform, and a destination's responseTransform.",
  "$ref": "#/$defs/Transform",
  "$defs": {
    "Transform": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "Free text, for example Transform"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name shown in errors"
        },
        "inputs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Informational list of inputs"
        },
        "steps": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Step"
          },
          "description": "Steps, run in order; none passes the message through unchanged"
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "description": "Exactly one of map, set, or filter",
      "properties": {
        "map": {
          "$ref": "#/$defs/MapStep"
        },
        "set": {
          "$ref": "#/$defs/SetStep"
        },
        "filter": {
          "$ref": "#/$defs/FilterStep"
        }
      }
    },
    "MapStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "description": "Copies the value at from to to, converting it when type is set; a missing from leaves to unchanged",
      "properties": {
        "from": {
          "type": "string",
          "description": "Dot path to read, for example PID.5.1 or rows.0.lastName",
          "pattern": "^[^.]+(\\.[^.]+)*$"
        },
        "to": {
          "type": "string",
          "description": "Dot path to write",
          "pattern": "^[^.]+(\\.[^.]+)*$"
        },
        "type": {
          "enum": [
            "",
            "string",
            "number",
            "boolean"
          ],
          "description": "Conversion: string, number, or boolean (empty: none)"
        }
      }
    },
    "SetStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "expr"
      ],
      "description": "Sets field to expr, replacing each {{path}} with that value",
      "properties": {
        "field": {
          "type": "string",
          "description": "Dot path to write",
          "pattern": "^[^.]+(\\.[^.]+)*$"
        },
        "expr": {
          "type": "string",
          "description": "Text with {{path}} placeholders"
        }
      }
    },
    "FilterStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "action"
      ],
      "description": "reject drops the message when when is true; accept drops it when when is false",
      "properties": {
        "when": {
          "type": "string",
          "description": "A path (true when present and not empty, 0, false, or null) or <operand> == <operand> / <operand> != <operand>",
          "pattern": "\\S"
        },
        "action": {
          "enum": [
            "reject",
            "accept"
          ]
        }
      }
    }
  }
}
