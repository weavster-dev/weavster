{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/weavster-dev/weavster/main/agent-docs/schemas/flow.schema.json",
  "title": "Weavster flow definition",
  "description": "Body of POST /api/v1/flows, PUT /api/v1/flows/{id}, and each entry of PUT /api/v1/flows and of an import document. status is managed by lifecycle operations and is not part of a definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "not": {
        "enum": [
          "export",
          "import",
          "redeploy-all",
          "connector-names",
          "ports-in-use",
          "stats",
          "deploy-all",
          "undeploy-all",
          "start-all",
          "stop-all",
          "pause-all",
          "halt-all",
          "resume-all"
        ]
      }
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceType": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "description": "Where the flow receives messages on its own; without it only the API sends it messages.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "title": "File source",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "dir"
          ],
          "properties": {
            "type": {
              "const": "file"
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "description": "Absolute directory to poll"
            },
            "pattern": {
              "type": [
                "string",
                "null"
              ],
              "description": "File-name glob (default *); no path separators"
            },
            "pollIntervalMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 100,
              "maximum": 3600000,
              "description": "Default 1000"
            },
            "moveTo": {
              "type": [
                "string",
                "null"
              ],
              "description": "Absolute directory processed files are moved to (default: deleted)"
            }
          }
        },
        {
          "title": "HTTP source",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "address"
          ],
          "properties": {
            "type": {
              "const": "http"
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "description": "host:port the flow listens on while it is started, e.g. 127.0.0.1:9001 or :9001"
            },
            "path": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^/",
              "description": "Request path accepted (default /)"
            },
            "method": {
              "enum": [
                "POST",
                "PUT",
                null
              ],
              "description": "Request method accepted (default POST)"
            },
            "username": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "^[^:]+$",
              "description": "HTTP Basic user name senders must present (with passwordEnv)"
            },
            "passwordEnv": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Name of the server environment variable holding the Basic password (with username)"
            },
            "certFile": {
              "type": [
                "string",
                "null"
              ],
              "description": "Absolute path of the PEM certificate chain; the port serves HTTPS (with keyFile)"
            },
            "keyFile": {
              "type": [
                "string",
                "null"
              ],
              "description": "Absolute path of the PEM private key (with certFile)"
            }
          },
          "dependentRequired": {
            "username": [
              "passwordEnv"
            ],
            "passwordEnv": [
              "username"
            ],
            "certFile": [
              "keyFile"
            ],
            "keyFile": [
              "certFile"
            ]
          }
        }
      ]
    },
    "enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "initialState": {
      "enum": [
        "started",
        "paused",
        "stopped",
        null
      ]
    },
    "dependsOn": {
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,128}$"
      }
    },
    "transform": {
      "$ref": "#/$defs/Transform"
    },
    "destinations": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Destination"
      }
    },
    "responseSelector": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    }
  },
  "$defs": {
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "type": {
          "enum": [
            "http",
            "file"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "responseTransform": {
          "$ref": "#/$defs/Transform"
        }
      }
    },
    "Transform": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "map": {
          "$ref": "#/$defs/MapStep"
        },
        "set": {
          "$ref": "#/$defs/SetStep"
        },
        "filter": {
          "$ref": "#/$defs/FilterStep"
        },
        "build": {
          "$ref": "#/$defs/BuildStep"
        },
        "destinationSet": {
          "$ref": "#/$defs/DestinationSetStep"
        }
      }
    },
    "MapStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "enum": [
            "",
            "string",
            "number",
            "boolean"
          ]
        }
      }
    },
    "SetStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "expr"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "expr": {
          "type": "string"
        }
      }
    },
    "FilterStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "action"
      ],
      "properties": {
        "when": {
          "type": "string"
        },
        "action": {
          "enum": [
            "reject",
            "accept"
          ]
        }
      }
    },
    "BuildStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "type": "string"
        },
        "format": {
          "type": "string"
        }
      }
    },
    "DestinationSetStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
